const path = require("path");
const fs = require("fs");

app.get(`/${API_PRESET}/*`, function (req, res) {
  const baseDir = path.resolve(appDirectory, "build");

  // Extract relative path safely
  const relativePath = req.path.replace(`/${API_PRESET}`, "");

  // Normalize path to remove traversal attempts
  const normalizedPath = path.normalize(relativePath);

  // Resolve inside base directory
  const fullPath = path.resolve(baseDir, "." + normalizedPath);

  // 🔒 Strict boundary check
  if (!fullPath.startsWith(baseDir + path.sep)) {
    return res.status(403).send("Forbidden");
  }

  // Ensure file exists
  if (!fs.existsSync(fullPath)) {
    return res.status(404).send("File not found");
  }

  return res.sendFile(fullPath);
});








