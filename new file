const { sanitizePath } = require('./utils/pathSanitizer');

const commonProxyReqPathResolver = (req) => {
    try {
        const pathPre = "";
        
        // Get the user-provided URL
        const originalPath = req.originalUrl.replace(/\/${API_PRESET}\/v1\//, '*/ccb/v1/*');
        
        // Sanitize the path to prevent traversal
        // Note: Adjust baseDirectory based on where this proxy should be confined
        const sanitizedPath = sanitizePath(originalPath, '/allowed/proxy/path', null, '');
        
        const updatedPath = pathPre + sanitizedPath;
        
        logger.log({
            message: `updatedPath: ${updatedPath} api requestId:${req.headers["x-citiportal-requestid"]}`,
            requestid: req.headers["x-citiportal-requestid"],
            level: "info"
        });
        
        return updatedPath;
        
    } catch (error) {
        logger.log({
            message: `[SECURITY] Path traversal blocked: ${req.originalUrl}`,
            requestid: req.headers["x-citiportal-requestid"],
            level: "error"
        });
        
        // Return a safe default or throw error
        throw new Error('Invalid path');
    }
};
