// utils/pathSanitizer.js
const path = require('path');

/**
 * Sanitizes user input path to prevent path traversal
 * @param {string} userPath - User-provided path (e.g., req.path)
 * @param {string} baseDirectory - Base directory to confine to
 * @param {string|RegExp} replacePattern - Optional pattern to replace
 * @param {string} replaceWith - Replacement string
 * @returns {string} - Sanitized absolute path
 * @throws {Error} - If path traversal detected
 */
function sanitizePath(userPath, baseDirectory, replacePattern = null, replaceWith = '') {
    // Step 1: Apply replacement
    let updatedPath = userPath;
    if (replacePattern) {
        updatedPath = updatedPath.replace(replacePattern, replaceWith);
    }

    // Step 2: Normalize and remove traversal sequences
    updatedPath = path.normalize(updatedPath).replace(/\.\./g, '');

    // Step 3: Join with base directory
    updatedPath = path.join(baseDirectory, updatedPath);

    // Step 4: Resolve paths
    const resolvedPath = path.resolve(updatedPath);
    const resolvedBase = path.resolve(baseDirectory);

    // Step 5: Validate
    if (!resolvedPath.startsWith(resolvedBase + path.sep) && resolvedPath !== resolvedBase) {
        throw new Error('Path traversal detected');
    }

    return resolvedPath;
}

module.exports = { sanitizePath };


